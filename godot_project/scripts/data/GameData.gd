static func get_bihyung_story_pages(stage_num: int, route_id: String = "wanderer") -> Array:
	var route_label := "ผู้พเนจร"
	match route_id:
		"kingless":
			route_label = "ราชาไร้บัลลังก์ (ฉีกชะตากรรม)"
		"tyrant":
			route_label = "จักรพรรดิทรราชแห่งโซล"
		"savior":
			route_label = "ผู้กอบกู้แห่งสถานีรถไฟ"

	match stage_num:
		1:
			return [
				{
					"header": "📡 แชนแนล #BI-7623 เปิดออกอากาศ! — บทนำสู่จุดจบของโลก",
					"text": (
						"\"อา~ อา~ เทสไมค์! ได้ยินกันไหมมนุษย์ทุกคนบนรถไฟใต้ดินสาย 3 ตู้ 3707!\"\n\n"
						+ "\"ข้าคือ 'บีฮยอง' โดเกบิระดับล่างผู้ดูแลแชนแนลนี้... ขออภัยที่ต้องขัดจังหวะเวลากลับบ้านของพวกเจ้า "
						+ "แต่ 'บริการฟรีของระบบดาวเคราะห์ 8612' สิ้นสุดลงในเวลา 19:00 น. นี้แล้ว!\"\n\n"
						+ "\"ตอนนี้เหล่า 'กลุ่มดาว' บนฟากฟ้ากำลังจับตาดูพวกเจ้าอยู่ หากไม่อยากหัวระเบิดตายฟรี... จงพิสูจน์คุณค่าการมีชีวิตของพวกเจ้าซะ!\""
					),
				},
				{
					"header": "📋 ภารกิจบทละครที่ 1 & คำแนะนำจากบีฮยอง",
					"text": (
						"\"กติกาง่ายมาก! [กำจัดสิ่งมีชีวิตอย่างน้อย 1 ตัว] ภายใน 3 นาที — ฟังให้ดีนะ ข้าพูดว่า 'สิ่งมีชีวิต' ไม่ได้เจาะจงว่าต้องเป็นมนุษย์... ฮิฮิ!\"\n\n"
						+ "• เงื่อนไขเคลียร์: กำจัดศัตรูอย่างน้อย 1 ตัว (หรือสำรวจตู้ 3 หากล่องแมลง!)\n"
						+ "• เวลาจำกัด: 3 นาที   |   รางวัล: 300 เหรียญ   |   เพดานเลเวล: Lv.16\n"
						+ "• เคล็ดลับลับ: จบไวตอนเวลายังเหลือ ≥ 02:50 แล้วออกทันที จะได้เจอ 'กลุ่มตัวเอกตู้ 3807'!\n"
						+ "• กด [Tab] อัปสเตตัส/เปิดถุงโดเกบี | กด [I] เปิดกระเป๋า | กด [H] เรียกข้ามาทวนเนื้อเรื่องได้ตลอด!"
					),
				},
			]
		2:
			return [
				{
					"header": "📡 บีฮยองรายงานสด! — สะพานตงโฮใต้ท้องฟ้าสีเลือด",
					"text": (
						"\"โอ้โห! รอดมาจากตู้ 3707 ได้จริงด้วยแฮะ! ยอดผู้ชมแชนแนล #BI-7623 พุ่งกระฉูดเลย!\"\n\n"
						+ "\"ดูนอกหน้าต่างสิ กรุงโซลที่พวกเจ้ารู้จักถูกขังไว้ใต้โดมยักษ์แล้ว สะพานตงโฮข้างหน้าถูก 'มังกรทะเลและอสูรแม่น้ำฮัน' ยึดครอง "
						+ "แถมยังมี 'หมอกพิษ' แผ่ปกคลุมกลางสะพานอีกต่างหาก!\"\n\n"
						+ "\"ข้ามสะพานนี้ไปให้ถึง 'สถานีโอกซู' ให้ได้ เหล่ากลุ่มดาวกำลังรอจ่ายเหรียญให้คนที่รอดชีวิตอยู่นะ!\""
					),
				},
				{
					"header": "📋 ภารกิจบทละครที่ 2 & คำแนะนำจากบีฮยอง",
					"text": (
						"\"อย่าเดินดุ่มๆ เข้าหมอกพิษตัวเปล่าล่ะ เดี๋ยวจะหาว่าโดเกบิใจร้ายไม่เตือน!\"\n\n"
						+ "• เงื่อนไขเคลียร์: โค่น 'อสูรสะพานตงโฮ' + กำจัดอสูรให้ครบ แล้วกด [F] เข้าประตูสถานีโอกซู\n"
						+ "• เควสรอง: หา 'หน้ากากกันหมอกพิษ' จากลังบนสะพาน หรือซื้อจากถุงโดเกบี [B]\n"
						+ "• เวลาจำกัด: 3 นาที 30 วิ   |   รางวัล: 500 เหรียญ   |   เส้นทางปัจจุบัน: %s" % route_label
					),
				},
			]
		3:
			return [
				{
					"header": "📡 บีฮยองรายงานสด! — ค่ำคืนแห่งความมืด ณ สถานีโอกซู",
					"text": (
						"\"ยินดีต้อนรับสู่สถานีโอกซู! ค่ำคืนแรกหลังวันสิ้นโลกกำลังจะเริ่มต้นขึ้นแล้ว...\"\n\n"
						+ "\"เมื่อไฟในสถานีดับลง 'อสูรยามราตรี' จะกรูกันออกมาจากอุโมงค์มืด มีเพียงพื้นที่สีเขียว 'Green Zone' เท่านั้นที่กันความมืดได้ "
						+ "แต่พื้นที่มันมีจำกัด... มนุษย์จะแย่งกันหรือจะช่วยกันปกป้องล่ะ? กลุ่มดาวชอบดูดราม่าแบบนี้สุดๆ เลย!\""
					),
				},
				{
					"header": "📋 ภารกิจบทละครที่ 3 & คำแนะนำจากบีฮยอง",
					"text": (
						"\"เปิดเสา Green Zone กลางชานชาลา แล้วเอาชีวิตรอดให้ครบ 3 เวฟให้ได้!\"\n\n"
						+ "• เงื่อนไขเคลียร์: กด [F] ที่เสา Green Zone แล้วต้านอสูร 3 เวฟ + โค่นบอสประจำสถานี\n"
						+ "• คำเตือน: ออกนอกวง Green Zone ระหว่างเวฟ ความมืดจะกัดกิน HP ต่อเนื่อง!\n"
						+ "• เควสรอง: วิ่งฝ่าความมืดไปด้านขวาเพื่อช่วยผู้รอดชีวิต (+200 เหรียญ)   |   รางวัล: 700 เหรียญ"
					),
				},
			]
		4:
			return [
				{
					"header": "📡 บีฮยองรายงานสด! — สงครามชิงธงราชาแห่งสถานี",
					"text": (
						"\"ฮ่าๆๆ! ในที่สุดก็มาถึงบทละครใหญ่ที่เหล่ากลุ่มดาวรอคอย — 'ศึกชิงตำแหน่งราชา'!\"\n\n"
						+ "\"ตอนนี้ผู้รอดชีวิตทั่วกรุงโซลเริ่มตั้งก๊กเป็นราชาตามแต่ละสถานีแล้ว ใครที่ยึดธงประจำสถานีและโค่นทรราชลงได้ "
